# Supabase project (Settings > API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server routes only. Must match: select value from private.app_secrets where name = 'api';
# Generate with `openssl rand -hex 32` and insert it into private.app_secrets.
GPE_API_SECRET=

# Optional, server-side scripts only. The app never needs it: route handlers act as
# the calling device and prove themselves to Postgres with GPE_API_SECRET.
SUPABASE_SERVICE_ROLE_KEY=
